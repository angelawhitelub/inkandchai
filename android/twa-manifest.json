{
  "packageId": "in.inkandchai.app",
  "host": "inkandchai.in",
  "name": "Ink & Chai — An Indian Bookshop",
  "launcherName": "Ink & Chai",
  "display": "standalone",
  "orientation": "default",
  "themeColor": "#0d0b08",
  "themeColorDark": "#0d0b08",
  "navigationColor": "#0d0b08",
  "navigationColorDark": "#0d0b08",
  "navigationDividerColor": "#0d0b08",
  "navigationDividerColorDark": "#0d0b08",
  "backgroundColor": "#0d0b08",
  "enableNotifications": false,
  "startUrl": "/",
  "webManifestUrl": "https://inkandchai.in/manifest.json",
  "iconUrl": "https://inkandchai.in/images/icon-512.png",
  "maskableIconUrl": "https://inkandchai.in/images/icon-maskable-512.png",
  "splashScreenFadeOutDuration": 300,
  "signingKey": { "path": "./android.keystore", "alias": "inkandchai" },
  "appVersionName": "1.0.0",
  "appVersionCode": 1,
  "minSdkVersion": 23,
  "fallbackType": "customtabs",
  "enableSiteSettingsShortcut": true,
  "isChromeOSOnly": false,
  "isMetaQuest": false,
  "fullScopeUrl": "https://inkandchai.in/",
  "additionalTrustedOrigins": [],
  "shortcuts": [
    { "name": "Bestsellers",  "shortName": "Bestsellers", "url": "/bestsellers/",  "chosenIconUrl": "https://inkandchai.in/images/icon-192.png" },
    { "name": "New arrivals", "shortName": "New",         "url": "/new-arrivals/", "chosenIconUrl": "https://inkandchai.in/images/icon-192.png" },
    { "name": "Track order",  "shortName": "Track",       "url": "/track/",        "chosenIconUrl": "https://inkandchai.in/images/icon-192.png" },
    { "name": "Your cart",    "shortName": "Cart",        "url": "/cart/",         "chosenIconUrl": "https://inkandchai.in/images/icon-192.png" }
  ]
}

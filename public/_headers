# Cloudflare Pages merges every matching rule into one header value, so a
# Cache-Control on /* would be appended to the asset rules below and produce a
# self-contradicting header. Pages already defaults HTML to
# "public, max-age=0, must-revalidate", so /* carries security headers only.

# Image filenames are NOT content-hashed, so "immutable" would make a replaced
# cover impossible to push out — and turns any bad response into a year-long
# cache entry. A week is long enough to be cheap and short enough to recover.
/images/*
  Cache-Control: public, max-age=604800
/js/books-full-*.js
  Cache-Control: public, max-age=31536000, immutable
/js/books-lite-*.js
  Cache-Control: public, max-age=31536000, immutable

# The app shell (bottom tab bar + cart drawer) is identical on all ~140 browse
# pages, so it is served content-hashed and cached for good: a browse session
# fetches it once instead of re-downloading it inline with every page. The hash
# in the filename is what makes a change reach people.
/css/app-shell-*.css
  Cache-Control: public, max-age=31536000, immutable
/js/app-shell-*.js
  Cache-Control: public, max-age=31536000, immutable
/css/book-card-*.css
  Cache-Control: public, max-age=31536000, immutable
/js/book-card-*.js
  Cache-Control: public, max-age=31536000, immutable

# The service worker is the one file that must never go stale. It is also the
# only way to uninstall a bad one: browsers re-fetch sw.js on navigation, so a
# worker that unregisters itself reaches every installed client within a visit
# — but only if this header stops a CDN or a browser holding the old copy.
/sw.js
  Cache-Control: public, max-age=0, must-revalidate

# Digital Asset Links. Google's verifier requires application/json served
# directly, with no redirect, or the Android app shows a browser URL bar
# instead of running full-screen.
/.well-known/assetlinks.json
  Content-Type: application/json
  Cache-Control: public, max-age=300
  Access-Control-Allow-Origin: *

/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin

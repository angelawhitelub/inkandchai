# ── Cache rules — read top to bottom; first match wins per path ────────────

# 1. Never cache any HTML (browser must revalidate every time → instant updates)
/*.html
  Cache-Control: public, max-age=0, must-revalidate

# 2. Pretty URLs (no .html) — same rule, browser always checks for updates
/
  Cache-Control: public, max-age=0, must-revalidate
/product/*
  Cache-Control: public, max-age=0, must-revalidate
/checkout/*
  Cache-Control: public, max-age=0, must-revalidate
/collection/*
  Cache-Control: public, max-age=0, must-revalidate
/category/*
  Cache-Control: public, max-age=0, must-revalidate
/admin/*
  Cache-Control: no-store, max-age=0
/terms/*
  Cache-Control: public, max-age=0, must-revalidate
/privacy-policy/*
  Cache-Control: public, max-age=0, must-revalidate
/refund-policy/*
  Cache-Control: public, max-age=0, must-revalidate
/return-policy/*
  Cache-Control: public, max-age=0, must-revalidate
/shipping-policy/*
  Cache-Control: public, max-age=0, must-revalidate

# 3. Versioned books-data JS — cache 1 year (content hash in filename changes each deploy)
/js/books-full-*.js
  Cache-Control: public, max-age=31536000, immutable
/js/books-lite-*.js
  Cache-Control: public, max-age=31536000, immutable

# 4. Other JS — short cache + must-revalidate (so JS bug fixes ship same-day)
/*.js
  Cache-Control: public, max-age=300, must-revalidate
/js/*
  Cache-Control: public, max-age=300, must-revalidate

# 4. CSS — same
/*.css
  Cache-Control: public, max-age=300, must-revalidate

# 5. Images & fonts — cache hard for 1 year (filenames don't change)
/images/*
  Cache-Control: public, max-age=31536000, immutable
/*.jpg
  Cache-Control: public, max-age=31536000, immutable
/*.jpeg
  Cache-Control: public, max-age=31536000, immutable
/*.png
  Cache-Control: public, max-age=31536000, immutable
/*.webp
  Cache-Control: public, max-age=31536000, immutable
/*.svg
  Cache-Control: public, max-age=31536000, immutable
/*.woff
  Cache-Control: public, max-age=31536000, immutable
/*.woff2
  Cache-Control: public, max-age=31536000, immutable

# 6. Feed.xml — 1 hour cache (Google crawls ~daily; 10-min was causing ~13 GB/month)
/feed.xml
  Cache-Control: public, max-age=3600

/robots.txt
  Cache-Control: public, max-age=0, must-revalidate

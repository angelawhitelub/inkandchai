# Cloudflare Pages merges every matching rule into one header value, so a
# Cache-Control on /* would be appended to the asset rules below and produce a
# self-contradicting header. Pages already defaults HTML to
# "public, max-age=0, must-revalidate", so /* carries security headers only.

/images/*
  Cache-Control: public, max-age=31536000, immutable
/js/books-full-*.js
  Cache-Control: public, max-age=31536000, immutable
/js/books-lite-*.js
  Cache-Control: public, max-age=31536000, immutable

/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
